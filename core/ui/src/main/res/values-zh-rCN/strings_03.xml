    <string name="whats_new_title">Shellify 新功能</string>
    <string name="whats_new_subtitle">以下是自上次更新以来新增的内容。</string>
    <string name="whats_new_got_it">知道了</string>
    <string name="whats_new_reading_mode_title">阅读模式</string>
    <string name="whats_new_reading_mode_body">在任意应用中打开控制中心，即可将页面提取为纯文章内容 — 去除广告和导航栏，只保留正文。</string>
    <string name="whats_new_reader_security_title">安全阅读器</string>
    <string name="whats_new_reader_security_body">阅读视图会对注入内容进行净化，在显示前移除事件处理器和不安全链接。</string>
    <string name="whats_new_tor_reliability_title">Tor 稳定性</string>
    <string name="whats_new_tor_reliability_body">Tor 现在会报告连接错误，并强制执行 90 秒启动超时，不再出现无提示卡住的情况。</string>

    <string name="consent_update_title">我们更新了条款</string>
    <string name="consent_update_subtitle">我们对服务条款和隐私政策做了小幅更新。请查看变更并接受后继续使用 Shellify。</string>
    <string name="consent_update_changes_title">更新内容</string>
    <string name="consent_update_changes_1">新增了关于为通知、媒体控制和页面内翻译而注入 JavaScript 桥接代码的说明</string>
    <string name="consent_update_changes_2">明确说明启用页面内翻译功能时会加载由 Google 托管的脚本</string>
